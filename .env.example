# Database (Neon PostgreSQL - use the pooled connection string)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js / NextAuth
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Google OAuth (console.cloud.google.com credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudflare R2 (S3-compatible object storage)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# Email via Resend (password reset emails)
# Leave RESEND_API_KEY empty in dev to log reset links to the server console instead
RESEND_API_KEY=""
EMAIL_FROM="MSSN UI Library <onboarding@resend.dev>"

# Initial super admin created by `npm run db:seed`
SUPER_ADMIN_NAME=""
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""
